<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DC Notifier — танзимот"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Токени боти notifier:" />

        <EditText
            android:id="@+id/etToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="7123456789:AAxxxx..."
            android:inputType="text"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chat ID-и гурӯҳ (бо минус):" />

        <EditText
            android:id="@+id/etChatId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="-1001234567890"
            android:inputType="text"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💾 Сабт кардан"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📨 Санҷиш — паём фиристодан"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnNotifAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔔 Иҷозати хондани notification"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔋 Хомӯш кардани сарфаи батарея"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Санҷиши даврии DC City (ихтиёрӣ):"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PIN-и 4-рақамаи ҳисоби DC (дар ҳамин телефон бо рамзгузорӣ нигоҳ дошта мешавад):"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/etPin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="1234"
            android:inputType="numberPassword"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnSavePin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔐 PIN-ро сабт кардан"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="♿ Иҷозати Accessibility (барои хондани экран)"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnExactAlarm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⏰ Иҷозати Alarm дақиқ (ҳатмист!)"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ҳолат: —"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
